    <worksheet name='avgrage distance vs delivery duration'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Medium' underline='true'>Average Distance Vs Average Delivery Duration</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Delivery delays are tied to longer distances</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='new pizza data' name='federated.01573ce0uxeigj12180bc0qhs8k1' />
          </datasources>
          <datasource-dependencies datasource='federated.01573ce0uxeigj12180bc0qhs8k1'>
            <column datatype='integer' name='[Delivery Duration (min)]' role='measure' type='quantitative' />
            <column datatype='datetime' name='[Delivery Time]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Distance (km)]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[Is Delayed]' role='dimension' type='nominal' />
            <column-instance column='[Delivery Duration (min)]' derivation='Avg' name='[avg:Delivery Duration (min):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Distance (km)]' derivation='Avg' name='[avg:Distance (km):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Is Delayed]' derivation='None' name='[none:Is Delayed:nk]' pivot='key' type='nominal' />
            <column-instance column='[Delivery Time]' derivation='Year' name='[yr:Delivery Time:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.01573ce0uxeigj12180bc0qhs8k1].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.01573ce0uxeigj12180bc0qhs8k1].[avg:Delivery Duration (min):qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.01573ce0uxeigj12180bc0qhs8k1].[avg:Distance (km):qk]&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.01573ce0uxeigj12180bc0qhs8k1].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.01573ce0uxeigj12180bc0qhs8k1].[avg:Delivery Duration (min):qk]&quot;</bucket>
              <bucket>&quot;[federated.01573ce0uxeigj12180bc0qhs8k1].[avg:Distance (km):qk]&quot;</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.01573ce0uxeigj12180bc0qhs8k1].[:Measure Names]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' field='[federated.01573ce0uxeigj12180bc0qhs8k1].[:Measure Names]' value='115' />
          </style-rule>
          <style-rule element='table'>
